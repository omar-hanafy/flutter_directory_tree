# Local notes
FOLLOWUP.md

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Editor settings stay local.
.vscode/
.classpath
.project
.settings/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
# The example and benchmark lockfiles stay tracked.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
build/
coverage/

# Golden test failure images, written next to the failing test.
test/**/failures/

# Benchmark executables (dart compile exe writes *.exe on every OS).
/benchmark/**/*.exe

# Agent worktrees and local agent settings.
.claude/worktrees/
.claude/settings.local.json

# The example's platform folders ignore their own generated files.
