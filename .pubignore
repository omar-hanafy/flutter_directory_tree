# pub uses this file INSTEAD of .gitignore for this directory, so it repeats
# the .gitignore patterns that matter for the archive. pub always skips hidden
# files and directories (.dart_tool/, .github/, .idea/), and the .gitignore
# files inside example/ still apply there.

# Local artifacts and debug output (repeated from .gitignore).
/pubspec.lock
*.log
*.class
*.pyc
*.swp
*.iml
*.ipr
*.iws
**/doc/api/
build/
coverage/
migrate_working_dir/
test/**/failures/

# Development-only dependency overrides; the release commit deletes them.
pubspec_overrides.yaml

# The example lockfile records the resolution on a maintainer's machine
# (including override paths); users resolve the example themselves.
/example/pubspec.lock

# Maintainer-only tooling, benchmarks, agent files, and contributor docs.
/tool/
/tooling/
/benchmark/
.claude/
AGENTS.md
CLAUDE.md
docs_guide.md
firebase-debug.log
